# URL of your Jellyfin server (as reachable from this container)
JELLYFIN_URL=http://jellyfin:8096

# Jellyfin API key (Dashboard -> API Keys)
JELLYFIN_API_KEY=

# Key the Jellyamp app must send; choose any long random string
SONIC_API_KEY=

# Optional overrides
# DATABASE_PATH=data/jellyamp.sqlite
# ANALYSIS_CLIP_SECONDS=90
# SCAN_INTERVAL_MINUTES=60
