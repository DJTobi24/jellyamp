# ---- Required -------------------------------------------------------------

# URL of your Jellyfin server as reachable *from this container*.
#   same compose project:        http://jellyfin:8096
#   Jellyfin on the Docker host: http://host.docker.internal:8096
#   elsewhere on your network:   http://192.168.1.10:8096
JELLYFIN_URL=http://host.docker.internal:8096

# Jellyfin API key: Jellyfin → Dashboard → API Keys → "+" (name it "jellyamp").
JELLYFIN_API_KEY=

# The key the Jellyamp app must send. Any long random string (16+ chars),
# e.g. the output of:  openssl rand -hex 32
SONIC_API_KEY=

# ---- Optional -------------------------------------------------------------

# Sonic Sage (playlists from a text prompt). Leave empty to disable.
# When set, prompts and a summary of your library (genre names, artist names,
# track counts) are sent to Anthropic's API. See README "Sonic Sage".
# ANTHROPIC_API_KEY=
# SAGE_MODEL=claude-opus-5-5

# Analysis backend: auto (default) | dsp | essentia | none
#   dsp      built-in, needs only ffmpeg (included in the image)
#   essentia MusiCNN embeddings; needs the "full" image (WITH_ANALYSIS=1)
# ANALYSIS_BACKEND=auto

# Seconds of audio analyzed per track, from the middle of the track.
# 0 = whole tracks (exact loudness, far more work for Jellyfin).
# ANALYSIS_CLIP_SECONDS=90

# Tracks analyzed in parallel. Each one makes Jellyfin transcode a clip.
# ANALYSIS_CONCURRENCY=2

# Give up on a track after this many failed attempts.
# ANALYSIS_MAX_ATTEMPTS=3

# Minutes between library scans (the first scan runs right after startup).
# SCAN_INTERVAL_MINUTES=60

# LOG_LEVEL=INFO
