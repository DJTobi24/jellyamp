// Build settings for the Jellyamp app target (referenced from project.yml).
//
// Per-developer secrets live in Secrets.xcconfig next to this file, which is
// gitignored. The include is optional ("?"), so a checkout without it still
// builds — features that need a missing key switch themselves off.
// Copy Secrets.example.xcconfig to Secrets.xcconfig to get started.

LASTFM_API_KEY =
LASTFM_API_SECRET =

#include? "Secrets.xcconfig"
