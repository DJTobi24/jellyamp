// Copy to Secrets.xcconfig (gitignored) and fill in.
//
// Last.fm API account: https://www.last.fm/api/account/create
// (Application name "Jellyamp"; the callback URL can stay empty.)
// Without these the app builds and runs, but Last.fm scrobbling is hidden.

LASTFM_API_KEY = 0123456789abcdef0123456789abcdef
LASTFM_API_SECRET = 0123456789abcdef0123456789abcdef
