    "Singles & EPs" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singles & EPs"
          }
        }
      }
    },
    "Skips digital silence: lead-ins are shortened to half a second, and silent stretches inside or at the end of a track to two seconds. Hidden tracks and long fade-outs start sooner; nothing audible is removed. Takes effect from the next track or seek." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt digitale Stille: Vorläufe werden auf eine halbe Sekunde gekürzt, stille Passagen innerhalb oder am Ende eines Titels auf zwei Sekunden. Hidden Tracks und lange Ausblendungen beginnen früher; Hörbares wird nicht entfernt. Gilt ab dem nächsten Titel oder Sprung."
          }
        }
      }
    },
    "Skips to the next song in the queue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Springt zum nächsten Titel in der Warteschlange."
