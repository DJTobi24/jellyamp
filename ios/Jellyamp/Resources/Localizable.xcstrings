    "Playlists: “%@”" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlists: „%@“"
          }
        }
      }
    },
    "Plays an artist, album, playlist, song or genre from your Jellyfin library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt einen Interpreten, ein Album, eine Playlist, einen Titel oder ein Genre aus deiner Jellyfin-Bibliothek."
          }
        }
      }
    },
    "Plays every track at a similar loudness using the gain Jellyfin stores for it. Tracks of one album that follow each other share a single gain, so the album keeps its own dynamics." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt alle Titel ähnlich laut und nutzt dafür den Pegelwert, den Jellyfin für sie speichert. Aufeinanderfolgende Titel eines Albums teilen sich einen Wert, damit das Album seine eigene Dynamik behält."
          }
        }
      }
    },
    "Plays the albums most recently added to your library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Alben, die zuletzt zu deiner Bibliothek hinzugefügt wurden."
          }
        }
      }
    },
    "Plays the song" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt den Titel ab"
          }
        }
      }
    },
    "Plays this track again" : {
      "localizations" : {
        "de" : {
