    "Original" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original"
          }
        }
      }
    },
    "Overlaps the end of a track with the start of the next. Consecutive tracks of the same album are never crossfaded, so live albums and DJ mixes play through uninterrupted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überlagert das Ende eines Titels mit dem Anfang des nächsten. Aufeinanderfolgende Titel desselben Albums werden nie überblendet, damit Live-Alben und DJ-Mixe ohne Unterbrechung durchlaufen."
          }
        }
      }
    },
