    "Similar items and Instant Mix from Jellyfin's metadata." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ähnliches und Sofort-Mix auf Basis der Jellyfin-Metadaten."
