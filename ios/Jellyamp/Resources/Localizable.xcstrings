        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Sync"
          }
        }
      }
    },
    "Smart Sync keeps this music downloaded automatically and removes it again when it no longer matches. Music you download yourself is never removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Sync hält diese Musik automatisch geladen und entfernt sie wieder, wenn sie nicht mehr dazugehört. Musik, die du selbst lädst, wird nie entfernt."
          }
        }
      }
    },
    "Something answered at this address, but it isn't a Jellyfin server. Check the port (Jellyfin uses 8096 by default) and any path your reverse proxy needs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Adresse antwortet etwas, aber kein Jellyfin-Server. Prüfe den Port (Jellyfin verwendet standardmäßig 8096) und einen eventuell nötigen Pfad deines Reverse-Proxys."
          }
        }
      }
    },
